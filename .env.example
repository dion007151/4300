NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forfree
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=4300-files
S3_ACCESS_KEY=local
S3_SECRET_KEY=local-secret

# ── Auth (NextAuth v5) ─────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-generate-with-openssl-rand-base64-32

# ── Gmail Email Auth ───────────────────────────────────────
# Generate at: Gmail → Settings → Security → 2-Step → App Passwords
GMAIL_APP_PASSWORD=

# ── OAuth Providers ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI Provider (pick one) ─────────────────────────────────
# Leave blank to use the built-in mock streaming response.
AI_PROVIDER=groq
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
